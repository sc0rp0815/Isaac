# Isaac free-cloud image (no billing, slim deps)
# Multi-stage build for minimal image size
# Suitable for: Render free, Hugging Face Spaces (Docker), Fly free allowance, Railway trial

# Stage 1: Build dependencies
FROM python:3.12-slim as builder

WORKDIR /app

# Install build dependencies (for pip compilation)
RUN apt-get update && apt-get install -y --no-install-recommends gcc && \
    rm -rf /var/lib/apt/lists/*

COPY requirements-free.txt .
RUN pip install --user --no-cache-dir -r requirements-free.txt

# Stage 2: Runtime image
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ISAAC_FREE_CLOUD=1 \
    ISAAC_UNIFIED_PORT=1 \
    ISAAC_BIND_HOST=0.0.0.0 \
    ISAAC_DISABLE_VECTOR_MEMORY=1 \
    ACTIVE_PROVIDER=groq \
    PORT=7860 \
    PATH="/root/.local/bin:$PATH"

WORKDIR /app

# Copy only necessary files from builder
COPY --from=builder /root/.local /root/.local
COPY *.py ./
COPY dashboard.html ./
COPY docs ./docs
COPY scripts ./scripts

# Runtime directories
RUN mkdir -p data logs workspace

EXPOSE 7860

# Health: GET /healthz (optimiert für Render Free Cold-Starts)
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD python -c "import os,urllib.request; p=os.environ.get('PORT','7860'); urllib.request.urlopen(f'http://127.0.0.1:{p}/healthz', timeout=8)"

CMD ["python", "isaac_core.py"]
